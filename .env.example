# Application
APP_NAME=Material Intelligence
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
SECRET_KEY=change-me-to-a-long-random-string
SESSION_MAX_AGE_SECONDS=86400

# Database — SQLite for local development; PostgreSQL for production
DATABASE_URL=sqlite:///./data/material_intelligence.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/material_intelligence

# Storage paths (relative to project root)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATASET_DIR=./data/datasets
MODEL_DIR=./data/models
REPORT_DIR=./data/reports
JOB_DIR=./data/jobs

# Upload limits
MAX_UPLOAD_MB=50
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.tif,.tiff,.webp
ALLOWED_ARCHIVE_EXTENSIONS=.zip

# ML defaults (CPU-friendly)
DEFAULT_DEVICE=cpu
YOLO_VARIANT=yolov8n
EFFICIENTNET_IMAGE_SIZE=224
TRAINING_SEED=42

# Auth — bootstrap administrator (change after first login)
BOOTSTRAP_ADMIN_EMAIL=admin@material-intelligence.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!
BOOTSTRAP_ADMIN_NAME=System Administrator

# Logging
LOG_LEVEL=INFO
